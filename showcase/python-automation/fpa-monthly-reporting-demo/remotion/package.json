    "poster": "remotion still src/index.ts FpaAutomationDemo ../assets/fpa-monthly-reporting-remotion-poster.jpg --frame=1900 --image-format=jpeg",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
